# MCP Server Configuration
RCSB_DOWNLOADER_PORT=8001
LIGAND_PREPARER_PORT=8002
PROTEIN_PREPARER_PORT=8003
MOLDINA_RUNNER_PORT=8004
PYMOL_VISUALIZER_PORT=8005

# RCSB Search API (override to point at a local mirror or different version)
# RCSB_SEARCH_URL=https://search.rcsb.org/rcsbsearch/v2/query

# Data directories
DATA_DIR=./data
CACHE_DIR=./cache

# RCSB API
RCSB_API_URL=https://data.rcsb.org/rest/v1

# Docking defaults
DEFAULT_EXHAUSTIVENESS=8
DEFAULT_TOP_N=3

# Resource limits
MAX_JOB_RUNTIME_SECONDS=3600
MAX_CONCURRENT_JOBS=5

# Logging
LOG_LEVEL=INFO
