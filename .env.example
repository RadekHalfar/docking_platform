# LLM Provider Configuration
# Ollama (default — local, free, private; supports DeepSeek, LLaMA, Mistral, Qwen, etc.)
LLM_PROVIDER=ollama
LLM_ENDPOINT=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b-instruct-q4_K_M

# OpenAI (cloud, paid — requires API key):
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Anthropic (cloud, paid — requires API key):
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5-20251001

# OpenAI-compatible local server (LM Studio, vLLM, Jan, llama.cpp, Groq, Together AI):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:1234/v1   # LM Studio default
# LLM_BASE_URL=http://localhost:8000/v1   # vLLM default
# LLM_BASE_URL=https://api.groq.com/openai/v1   # Groq cloud
# LLM_API_KEY=lm-studio                  # placeholder for servers that require a non-empty key
# LLM_MODEL=local-model

# MCP Server Configuration
# Under Docker Compose these set the HOST-side port only (change them to
# resolve "Address already in use"); the container always listens on its
# normal internal port regardless of this value. Running services directly
# with `python -m services.X.server` (no Docker) uses these as the actual
# listen port instead.
RCSB_DOWNLOADER_PORT=8001
LIGAND_PREPARER_PORT=8002
PROTEIN_PREPARER_PORT=8003
MOLDINA_RUNNER_PORT=8004
PYMOL_VISUALIZER_PORT=8005

# RCSB Search API (override to point at a local mirror or different version)
# RCSB_SEARCH_URL=https://search.rcsb.org/rcsbsearch/v2/query

# Data directories
DATA_DIR=./data
CACHE_DIR=./cache

# RCSB API
RCSB_API_URL=https://data.rcsb.org/rest/v1

# Docking defaults
DEFAULT_EXHAUSTIVENESS=8
DEFAULT_TOP_N=3

# Resource limits
MAX_JOB_RUNTIME_SECONDS=3600
MAX_CONCURRENT_JOBS=5

# Logging
LOG_LEVEL=INFO
