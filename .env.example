# How this file is read: Docker Compose substitutes it into docker-compose.yml,
# which passes only the LLM_* variables (to the ui and script-runner
# containers) and the four *_PORT host ports below. No Python code loads
# .env, so a run outside Docker (python nlp_orchestrator.py, python -m
# services.X.server) sees these values only if you export them in your shell.

# LLM Provider Configuration
# Default: no LLM (LLM_PROVIDER=none). The GUI's forms, Run Docking and chat
# commands such as "run" work without one; only natural-language parsing
# (GUI chat, CLI commands) needs an LLM. Pick one here or in the GUI's
# Settings dialog.
LLM_PROVIDER=none

# Ollama (local, free, private). Not started by default -- run
#   docker compose --profile local-llm up -d ollama
# Under Docker Compose the containers reach it at http://ollama:11434 (the
# default, so LLM_ENDPOINT can stay unset); a native Ollama app on the host
# is http://host.docker.internal:11434. http://localhost:11434 is only right
# for a GUI or CLI run outside Docker -- inside a container it is the
# container itself.
# LLM_PROVIDER=ollama
# LLM_ENDPOINT=http://ollama:11434
# LLM_MODEL=gemma3:4b

# OpenAI (cloud, paid — requires API key):
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Anthropic (cloud, paid — requires API key):
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5-20251001

# MetaCentrum / e-INFRA CZ hosted LLM gateway (cloud, academic — requires an
# e-INFRA CZ bearer token; base URL defaults to https://llm.ai.e-infra.cz/v1
# and only needs LLM_BASE_URL if you're pointed at a different deployment):
# LLM_PROVIDER=metacentrum
# LLM_API_KEY=<your e-infra CZ bearer token>
# LLM_MODEL=<verify via GET https://llm.ai.e-infra.cz/v1/models>
# LLM_BASE_URL=https://llm.ai.e-infra.cz/v1

# OpenAI-compatible local server (LM Studio, vLLM, Jan, llama.cpp, Groq, Together AI):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:1234/v1   # LM Studio default
# LLM_BASE_URL=http://localhost:8000/v1   # vLLM default
# LLM_BASE_URL=https://api.groq.com/openai/v1   # Groq cloud
# LLM_API_KEY=lm-studio                  # placeholder for servers that require a non-empty key
# LLM_MODEL=local-model

# MCP Server Configuration
# Under Docker Compose these set the HOST-side port only (change them to
# resolve "Address already in use"); the container always listens on its
# normal internal port regardless of this value. A service started directly
# with `python -m services.X.server` (no Docker) listens on the exported
# environment variable of the same name, if set, else on its default.
RCSB_DOWNLOADER_PORT=8001
LIGAND_PREPARER_PORT=8002
PROTEIN_PREPARER_PORT=8003
MOLDINA_RUNNER_PORT=8004

# Native runs only (export them in your shell; docker-compose.yml does not
# pass them into the service containers, which use the defaults shown):
#
# CACHE_DIR: shared download cache (default ./cache).
# CACHE_DIR=./cache
#
# RCSB_SEARCH_URL: RCSB Search API, e.g. a local mirror.
# RCSB_SEARCH_URL=https://search.rcsb.org/rcsbsearch/v2/query
#
# MAX_JOB_RUNTIME_SECONDS: per-tool-call timeout enforced by every MCP
# service (common/mcp_base.py) -- a call that runs longer than this gets a
# timeout error response instead of hanging the caller forever. Does not
# cancel the handler itself; it keeps running in the background until any
# of its own internal timeouts (e.g. moldina_runner's per-ligand subprocess
# timeout) end it. Default 3600.
# MAX_JOB_RUNTIME_SECONDS=3600
