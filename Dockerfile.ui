FROM mcp-docking-base:latest

# The web GUI (NiceGUI). Versions pinned exactly, as tested. pytest-asyncio is for the GUI test tier (NiceGUI's User fixture is
# async).
RUN pip install --no-cache-dir \
    "nicegui==3.17.1" \
    "pytest-asyncio==1.4.0" \
    "plotly==7.1.0" \
    "pandas==3.0.6"

# appuser (uid 1000) already exists in mcp-docking-base. Every UI write lands
# in the rw cache/ and orchestrator_output/ mounts (see docker-compose.yml).
USER appuser

WORKDIR /workspace

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD curl -sf http://localhost:3000/health || exit 1

CMD ["python", "ui_nice/app.py"]
