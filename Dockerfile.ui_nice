FROM mcp-docking-base:latest

# NiceGUI GUI (Phase 16). Runs next to the Streamlit `ui` service until the
# Stage 16.8 cutover. Versions pinned exactly: nicegui as verified by the
# Stage 16.0 spike, plotly/pandas as in the current `ui` image.
# pytest-asyncio is for the ui-nice test tier (NiceGUI's User fixture is async).
RUN pip install --no-cache-dir \
    "nicegui==3.17.1" \
    "pytest-asyncio==1.4.0" \
    "plotly==7.1.0" \
    "pandas==3.0.6"

# appuser (uid 1000) already exists in mcp-docking-base. Every UI write lands
# in the rw cache/ and orchestrator_output/ mounts (see docker-compose.yml).
USER appuser

WORKDIR /workspace

EXPOSE 3001

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD curl -sf http://localhost:3001/health || exit 1

CMD ["python", "ui_nice/app.py"]
